{
  "printWidth": 100,
  "singleQuote": true,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "never",
        "printWidth": 200,
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
